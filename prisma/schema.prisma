// ============================================================
// Plataforma Educativa de IA — Schema de Base de Datos
// PostgreSQL + Prisma ORM
// ============================================================

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma/client"
}

datasource db {
  provider = "postgresql"
}

// ============================================================
// ENUMS
// ============================================================

enum LevelSlug {
  introduccion
  basico
  intermedio
  avanzado
  pro
}

enum ContentType {
  TEXT
  VIDEO
  EXERCISE
}

enum ExerciseType {
  QUIZ
  PROMPT_PRACTICE
}

enum EnrollmentStatus {
  ACTIVE
  COMPLETED
  DROPPED
}

enum UserRole {
  STUDENT
  INSTRUCTOR
  ADMIN
}

// ============================================================
// USERS
// ============================================================

model User {
  id        String   @id @default(uuid()) @db.Uuid
  email     String   @unique
  name      String
  avatarUrl String?  @map("avatar_url")
  role      UserRole @default(STUDENT)
  password  String

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  enrollments          Enrollment[]
  userProgress         UserProgress[]
  userExerciseResults  UserExerciseResult[]
  userBadges           UserBadge[]
  comments             Comment[]

  @@index([email])
  @@index([deletedAt])
  @@map("users")
}

// ============================================================
// LEVELS
// ============================================================

model Level {
  id          String    @id @default(uuid()) @db.Uuid
  slug        LevelSlug @unique
  name        String
  description String?
  sortOrder   Int       @map("sort_order")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  courses Course[]

  @@index([sortOrder])
  @@map("levels")
}

// ============================================================
// COURSES
// ============================================================

model Course {
  id          String  @id @default(uuid()) @db.Uuid
  levelId     String  @map("level_id") @db.Uuid
  title       String
  slug        String  @unique
  description String?
  imageUrl    String? @map("image_url")
  sortOrder   Int     @map("sort_order")
  published   Boolean @default(false)

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  level       Level        @relation(fields: [levelId], references: [id])
  lessons     Lesson[]
  enrollments Enrollment[]

  @@index([levelId])
  @@index([slug])
  @@index([deletedAt])
  @@map("courses")
}

// ============================================================
// LESSONS
// ============================================================

model Lesson {
  id          String  @id @default(uuid()) @db.Uuid
  courseId     String  @map("course_id") @db.Uuid
  title       String
  slug        String
  description String?
  sortOrder   Int     @map("sort_order")
  published   Boolean @default(false)

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  course         Course          @relation(fields: [courseId], references: [id])
  lessonContents LessonContent[]
  userProgress   UserProgress[]
  comments       Comment[]

  @@unique([courseId, slug])
  @@index([courseId, sortOrder])
  @@index([deletedAt])
  @@map("lessons")
}

// ============================================================
// LESSON CONTENT (text, video, exercise reference)
// ============================================================

model LessonContent {
  id          String      @id @default(uuid()) @db.Uuid
  lessonId    String      @map("lesson_id") @db.Uuid
  contentType ContentType @map("content_type")
  sortOrder   Int         @map("sort_order")

  // TEXT content
  body String? @db.Text

  // VIDEO content
  videoUrl      String? @map("video_url")
  videoDuration Int?    @map("video_duration_seconds")

  // EXERCISE reference (nullable — only set when contentType = EXERCISE)
  exerciseId String? @unique @map("exercise_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  lesson   Lesson    @relation(fields: [lessonId], references: [id])
  exercise Exercise? @relation(fields: [exerciseId], references: [id])

  @@index([lessonId, sortOrder])
  @@map("lesson_contents")
}

// ============================================================
// EXERCISES
// ============================================================

model Exercise {
  id           String       @id @default(uuid()) @db.Uuid
  exerciseType ExerciseType @map("exercise_type")
  title        String
  instructions String       @db.Text

  // QUIZ fields
  // (options stored in QuizOption child table)

  // PROMPT_PRACTICE fields
  systemPrompt    String? @map("system_prompt") @db.Text
  evaluationRubric String? @map("evaluation_rubric") @db.Text

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  lessonContent       LessonContent?
  quizOptions         QuizOption[]
  userExerciseResults UserExerciseResult[]

  @@map("exercises")
}

// ============================================================
// QUIZ OPTIONS (for multiple-choice exercises)
// ============================================================

model QuizOption {
  id         String  @id @default(uuid()) @db.Uuid
  exerciseId String  @map("exercise_id") @db.Uuid
  text       String
  isCorrect  Boolean @default(false) @map("is_correct")
  sortOrder  Int     @map("sort_order")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  exercise Exercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)

  @@index([exerciseId, sortOrder])
  @@map("quiz_options")
}

// ============================================================
// ENROLLMENTS
// ============================================================

model Enrollment {
  id       String           @id @default(uuid()) @db.Uuid
  userId   String           @map("user_id") @db.Uuid
  courseId  String           @map("course_id") @db.Uuid
  status   EnrollmentStatus @default(ACTIVE)

  enrolledAt  DateTime  @default(now()) @map("enrolled_at")
  completedAt DateTime? @map("completed_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user   User   @relation(fields: [userId], references: [id])
  course Course @relation(fields: [courseId], references: [id])

  @@unique([userId, courseId])
  @@index([userId])
  @@index([courseId])
  @@map("enrollments")
}

// ============================================================
// USER PROGRESS (per lesson)
// ============================================================

model UserProgress {
  id       String @id @default(uuid()) @db.Uuid
  userId   String @map("user_id") @db.Uuid
  lessonId String @map("lesson_id") @db.Uuid

  completed   Boolean   @default(false)
  completedAt DateTime? @map("completed_at")
  lastAccessedAt DateTime? @map("last_accessed_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user   User   @relation(fields: [userId], references: [id])
  lesson Lesson @relation(fields: [lessonId], references: [id])

  @@unique([userId, lessonId])
  @@index([userId])
  @@index([lessonId])
  @@map("user_progress")
}

// ============================================================
// USER EXERCISE RESULTS
// ============================================================

model UserExerciseResult {
  id         String @id @default(uuid()) @db.Uuid
  userId     String @map("user_id") @db.Uuid
  exerciseId String @map("exercise_id") @db.Uuid

  // QUIZ results
  selectedOptionId String? @map("selected_option_id") @db.Uuid
  isCorrect        Boolean? @map("is_correct")

  // PROMPT_PRACTICE results
  userResponse   String? @map("user_response") @db.Text
  aiFeedback     String? @map("ai_feedback") @db.Text
  score          Float?

  attemptNumber Int @default(1) @map("attempt_number")

  createdAt DateTime @default(now()) @map("created_at")

  user     User     @relation(fields: [userId], references: [id])
  exercise Exercise @relation(fields: [exerciseId], references: [id])

  @@index([userId, exerciseId])
  @@index([exerciseId])
  @@map("user_exercise_results")
}

// ============================================================
// BADGES
// ============================================================

model Badge {
  id           String  @id @default(uuid()) @db.Uuid
  name         String  @unique
  description  String?
  icon         String?
  criteriaJson Json?   @map("criteria_json")

  createdAt DateTime @default(now()) @map("created_at")

  userBadges UserBadge[]

  @@map("badges")
}

// ============================================================
// USER BADGES
// ============================================================

model UserBadge {
  id       String @id @default(uuid()) @db.Uuid
  userId   String @map("user_id") @db.Uuid
  badgeId  String @map("badge_id") @db.Uuid
  earnedAt DateTime @default(now()) @map("earned_at")

  user  User  @relation(fields: [userId], references: [id])
  badge Badge @relation(fields: [badgeId], references: [id])

  @@unique([userId, badgeId])
  @@index([userId])
  @@index([badgeId])
  @@map("user_badges")
}

// ============================================================
// COMMENTS (threaded)
// ============================================================

model Comment {
  id       String  @id @default(uuid()) @db.Uuid
  userId   String  @map("user_id") @db.Uuid
  lessonId String  @map("lesson_id") @db.Uuid
  body     String  @db.Text
  parentId String? @map("parent_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user     User      @relation(fields: [userId], references: [id])
  lesson   Lesson    @relation(fields: [lessonId], references: [id])
  parent   Comment?  @relation("CommentThread", fields: [parentId], references: [id])
  replies  Comment[] @relation("CommentThread")

  @@index([lessonId, createdAt])
  @@index([userId])
  @@index([parentId])
  @@map("comments")
}
