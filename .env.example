# ============================================================
# Variables de entorno — Certificaciones AI
# Copia este archivo a .env.local y rellena los valores.
# (En local también puedes bajarlas de Vercel con: vercel env pull .env.local --environment production)
# ============================================================

# ------------------------------------------------------------
# Base de datos (Supabase PostgreSQL) — REQUERIDA
# Supabase Dashboard -> Settings -> Database -> Connection string
# Pooler (puerto 6543): la usa la app en runtime
# ------------------------------------------------------------
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres"

# Conexión directa (puerto 5432) — OPCIONAL
# Solo la usan las migraciones de Prisma. Si no está, se usa DATABASE_URL.
DIRECT_URL="postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres"

# ------------------------------------------------------------
# Supabase Auth / API — REQUERIDAS
# Dashboard -> Settings -> API Keys
# ------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL="https://<project-ref>.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="<anon-key-publica>"
# La service_role es SECRETA (nunca la subas al repo)
SUPABASE_SERVICE_ROLE_KEY="<service-role-key-secreta>"

# ------------------------------------------------------------
# Proveedores de LLM — REQUERIDAS (tutor, sandbox y buscador con IA)
# ------------------------------------------------------------
# https://aistudio.google.com/apikey
GEMINI_API_KEY="<gemini-api-key>"
# https://console.groq.com/keys
GROQ_API_KEY="<groq-api-key>"
